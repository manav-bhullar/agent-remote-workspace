<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the doorbell (mac-listener) running. install-mac.sh fills in the home-folder placeholder below. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.remoteworkspace.listener</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.scripts/mac-listener</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
